{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "pantheon",
    "title",
    "days"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "pantheon": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "days": {
      "type": "array",
      "minItems": 1
    },
    "assessment": {
      "type": "object",
      "required": ["title", "prompt", "questionCount", "questions"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "questionCount": { "const": 5 },
        "questions": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {
            "type": "object", "required": ["lessonId", "question"], "additionalProperties": false,
            "properties": { "lessonId": { "type": "string" }, "question": { "type": "object" } }
          }
        }
      }
    },
    "suggestedTopics": {
      "type": "array"
    },
    "visual": {
      "type": "object"
    }
  }
}
